<Project Sdk="WixToolset.Sdk/6.0.2">
    <PropertyGroup>
        <OutputType>Package</OutputType>
        <InstallerPlatform>x64</InstallerPlatform>
        <!-- A per-user install puts files in the user profile; ICE38 and ICE64 insist on registry key paths and folder removal for that, which is not needed here. -->
        <SuppressIces>ICE38;ICE60;ICE64;ICE91</SuppressIces>
        <OutputName>RelicWriter</OutputName>
        <!-- The installer takes the application's x.y.z from version.json (the Burn bundle and the MSI must agree). -->
        <AppVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\version.json')), '"app"\s*:\s*"(\d+\.\d+\.\d+)').Groups[1].Value)</AppVersion>
        <PublishDir>$(MSBuildProjectDirectory)\obj\publish</PublishDir>
        <DefineConstants>$(DefineConstants);AppVersion=$(AppVersion);PublishDir=$(PublishDir)</DefineConstants>
    </PropertyGroup>

    <!-- Only what the desktop app needs to run: its self-contained, trimmed publish output for 64-bit Windows (the runtime travels with it), no symbols. -->
    <Target Name="PublishApp" BeforeTargets="BeforeBuild">
        <RemoveDir Directories="$(PublishDir)" />
        <Exec Command="dotnet restore &quot;$(MSBuildThisFileDirectory)..\RelicWriter.Desktop\RelicWriter.Desktop.csproj&quot; -r win-x64 -p:Configuration=Release -p:PublishTrimmed=true -p:PublishReadyToRun=true -p:TrimMode=partial -p:InvariantGlobalization=true" />
        <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\RelicWriter.Desktop\RelicWriter.Desktop.csproj&quot; -c Release -r win-x64 --no-restore --self-contained true -p:Configuration=Release -p:PublishTrimmed=true -p:PublishReadyToRun=true -p:TrimMode=partial -p:InvariantGlobalization=true -p:DebugType=None -p:DebugSymbols=false -o &quot;$(PublishDir)&quot;" />
    </Target>
</Project>
