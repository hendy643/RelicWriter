<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!-- Per user: installs under %LocalAppData%\Programs and never asks for administrator rights. -->
    <Package Name="Relic Writer" Manufacturer="hendy643" Version="$(AppVersion)" UpgradeCode="a59062b0-e5e6-4205-8e9b-810dbb3760db" Scope="perUser">
        <MajorUpgrade DowngradeErrorMessage="A newer version of Relic Writer is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="ProgramsFolder" Name="Programs">
                <Directory Id="INSTALLFOLDER" Name="Relic Writer" />
            </Directory>
        </StandardDirectory>

        <!-- Everything the publish step produced, except the exe, which has the shortcut. -->
        <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
            <Files Include="$(PublishDir)\**">
                <Exclude Files="$(PublishDir)\RelicWriter.Desktop.exe" />
                <Exclude Files="$(PublishDir)\**\*.pdb" />
            </Files>
        </ComponentGroup>

        <!-- The exe and its Start menu shortcut share a component; a registry value in the user's hive keys it, and the GUID is fixed because "*" can't be used with one. -->
        <ComponentGroup Id="Launcher" Directory="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="f854b9cc-7362-4dce-9715-f93765973129">
                <File Id="RelicWriterExe" Source="$(PublishDir)\RelicWriter.Desktop.exe" />
                <Shortcut Id="StartMenuShortcutLink" Directory="ProgramMenuFolder" Name="Relic Writer" Target="[#RelicWriterExe]" WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU" Key="Software\RelicWriter" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <Feature Id="Main" Title="Relic Writer" Level="1">
            <ComponentGroupRef Id="AppFiles" />
            <ComponentGroupRef Id="Launcher" />
        </Feature>
    </Package>
</Wix>
