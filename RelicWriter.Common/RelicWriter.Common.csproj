<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
    </PropertyGroup>
    <ItemGroup>
        <!-- The game database: SQL scripts made by RelicWriter.Extractor gamedata, run into an in-memory SQLite database at start (see docs/game-database.md). -->
        <EmbeddedResource Include="..\Database\*.sql" LogicalName="Database.%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="RelicWriter.Tests" />
        <InternalsVisibleTo Include="RelicWriter.Extractor" />
        <InternalsVisibleTo Include="RelicWriter.Model3D" />
        <InternalsVisibleTo Include="RelicWriter.GameAssets" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="K4os.Compression.LZ4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    </ItemGroup>
</Project>
