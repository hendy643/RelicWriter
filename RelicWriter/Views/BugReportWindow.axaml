<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RelicWriter.Controls"
        x:Class="RelicWriter.Views.BugReportWindow"
        Title="BUG REPORT"
        Width="720" Height="760" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CpBackground}">
    <controls:NotchedBorder Classes="panel" Margin="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Classes="h2" Text="BUG REPORT" />
            <TextBlock Grid.Row="1" Classes="dim" TextWrapping="Wrap"
                       Text="The issue page has opened in your browser. Copy this text into a new issue and fill in the rest. It holds versions and counts only: no names, paths or dates." />
            <TextBox x:Name="ReportText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <TextBlock x:Name="CopiedNote" Classes="dim" VerticalAlignment="Center" />
                <Button Classes="primary" Content="COPY" Click="OnCopy" />
                <Button Content="CLOSE" Click="OnClose" />
            </StackPanel>
        </Grid>
    </controls:NotchedBorder>
</Window>
