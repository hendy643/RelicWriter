<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RelicWriter.Controls"
             x:Class="RelicWriter.Views.CharacterView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="300,*,290" ColumnSpacing="16" Margin="0,0,0,24">

            <!-- V: portrait, life path, level and street cred, like the top of the in-game character screen -->
            <controls:NotchedBorder Grid.Column="0" Classes="panel">
                <StackPanel Spacing="12">
                    <Border Width="132" Height="132" BorderBrush="{StaticResource CpCyan}" BorderThickness="2" HorizontalAlignment="Left" Background="{StaticResource CpPanelRaised}">
                        <TextBlock Text="V" FontSize="84" FontWeight="Black" Foreground="{StaticResource CpCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="h2" Text="LIFE PATH" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding LifePath}" FontSize="22" FontWeight="Bold" />

                    <Rectangle Height="1" Fill="{StaticResource CpLine}" Margin="0,8" />

                    <TextBlock Classes="h2" Text="LEVEL" />
                    <TextBlock Classes="huge" Text="{Binding Level, StringFormat=N0}" />
                    <NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="60" Increment="1" FormatString="0" IsEnabled="{Binding CanEditLevel}" />

                    <TextBlock Classes="h2" Text="STREET CRED" Margin="0,10,0,0" />
                    <TextBlock Classes="big" Text="{Binding StreetCred, StringFormat=N0}" />
                    <NumericUpDown Value="{Binding StreetCred}" Minimum="1" Maximum="50" Increment="1" FormatString="0" IsEnabled="{Binding CanEditStreetCred}" />
                </StackPanel>
            </controls:NotchedBorder>

            <!-- Attributes and skills -->
            <StackPanel Grid.Column="1" Spacing="16">
                <controls:NotchedBorder Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="ATTRIBUTES" />
                        <ItemsControl ItemsSource="{Binding Attributes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:NotchedBorder Classes="card" Margin="0,0,10,0">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="dim" Text="{Binding Title}" FontSize="10" FontWeight="Bold" LetterSpacing="0.5" TextWrapping="Wrap" MinHeight="30" />
                                            <TextBlock Classes="big" Text="{Binding Value, StringFormat=N0}" />
                                            <Slider Minimum="3" Maximum="20" Value="{Binding Value}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </controls:NotchedBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:NotchedBorder>

                <controls:NotchedBorder Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="SKILLS" />
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="170,*,42" Margin="0,0,24,6">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="60" Value="{Binding Value}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat=N0}" FontWeight="Bold" Foreground="{StaticResource CpCyan}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                   Text="Skill names are the game's internal proficiency names; the in-game display names are not stored in the save." />
                    </StackPanel>
                </controls:NotchedBorder>
            </StackPanel>

            <!-- Unspent points -->
            <StackPanel Grid.Column="2" Spacing="16">
                <controls:NotchedBorder Classes="panel">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="UNSPENT POINTS" />
                        <TextBlock Classes="dim" Text="ATTRIBUTE POINTS" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" Margin="0,6,0,0" />
                        <NumericUpDown Value="{Binding AttributePoints}" Minimum="0" Maximum="999" Increment="1" FormatString="0" IsEnabled="{Binding CanEditAttributePoints}" />
                        <TextBlock Classes="dim" Text="PERK POINTS" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" Margin="0,6,0,0" />
                        <NumericUpDown Value="{Binding PerkPoints}" Minimum="0" Maximum="999" Increment="1" FormatString="0" IsEnabled="{Binding CanEditPerkPoints}" />
                        <TextBlock Classes="dim" Text="RELIC POINTS" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" Margin="0,6,0,0" />
                        <NumericUpDown Value="{Binding RelicPoints}" Minimum="0" Maximum="999" Increment="1" FormatString="0" IsEnabled="{Binding CanEditRelicPoints}" />
                    </StackPanel>
                </controls:NotchedBorder>
                <controls:NotchedBorder Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="BEFORE YOU SAVE" />
                        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                                   Text="Level, street cred, attributes and skills are changed on their own: experience points are left as they are; perks have their own tab. Loading an edited save in the game has not been tested yet, so keep the backup RelicWriter makes." />
                    </StackPanel>
                </controls:NotchedBorder>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
