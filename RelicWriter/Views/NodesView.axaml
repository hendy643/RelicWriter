<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelicWriter.Views.NodesView">
    <Grid ColumnDefinitions="*,340" ColumnSpacing="16" Margin="0,0,0,16">
        <Border Classes="panel">
            <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Classes="dim" Text="{Binding Summary}" FontSize="12" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
        <Border Grid.Column="1" Classes="panel" VerticalAlignment="Top">
            <StackPanel Spacing="8" DataContext="{Binding Selected}">
                <TextBlock Classes="h2" Text="NODE" />
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Details}" Foreground="{StaticResource CpDim}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
