<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelicWriter.Views.MainView">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Border Grid.Row="0" Classes="panel" Padding="24,14" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="RELICWRITER" VerticalAlignment="Center" />
                    <TextBlock Classes="dim" Text="SAVE EDITOR  ·  CYBERPUNK 2077 / PHANTOM LIBERTY" VerticalAlignment="Center" FontSize="12" LetterSpacing="2" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="GAME FOLDER…" Command="{Binding LocateGameCommand}" IsVisible="{Binding !HasGameIcons}" ToolTip.Tip="Vehicle pictures are read from the game's files. The game was not found; pick its folder." />
                    <TextBlock Classes="dim" Text="{Binding VersionText}" VerticalAlignment="Center" FontSize="12" LetterSpacing="2" />
                    <TextBlock Classes="dim" Text="{Binding GameDataText}" VerticalAlignment="Center" FontSize="12" LetterSpacing="2" ToolTip.Tip="Names and perks come from this database; vehicle pictures are read from the game files." />
                    <Button Content="OPEN…" Command="{Binding OpenCommand}" />
                    <Button Content="SAVE AS…" Command="{Binding SaveAsCommand}" />
                    <Button Classes="primary" Content="SAVE" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Welcome -->
        <Border Grid.Row="1" IsVisible="{Binding !IsLoaded}" Margin="48">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <TextBlock Classes="huge" Text="WAKE UP, V." HorizontalAlignment="Left" />
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Open a sav.dat from your Cyberpunk 2077 save folder. RelicWriter keeps a backup of the original file next to it the first time you save." />
                <TextBlock Classes="h2" Text="SAVES FOUND" Margin="0,12,0,0" IsVisible="{Binding HasRecentSaves}" />
                <ItemsControl ItemsSource="{Binding RecentSaves}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                                    Command="{Binding $parent[ItemsControl].DataContext.OpenRecentCommand}" CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="dim" Text="{Binding ModifiedText}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Editor tabs -->
        <TabControl x:Name="Tabs" Grid.Row="1" IsVisible="{Binding IsLoaded}" Margin="24,0,24,0">
            <TabItem Header="CHARACTER" IsEnabled="{Binding Character, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Character}" />
            </TabItem>
            <TabItem Header="PERKS" IsEnabled="{Binding Perks, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Perks}" />
            </TabItem>
            <TabItem x:Name="AppearanceTab" Header="APPEARANCE" IsEnabled="{Binding Appearance, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Appearance}" />
            </TabItem>
            <TabItem Header="INVENTORY" IsEnabled="{Binding Inventory, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Inventory}" />
            </TabItem>
            <TabItem Header="VEHICLES" IsEnabled="{Binding Vehicles, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Vehicles}" />
            </TabItem>
            <TabItem Header="SAVE INFO">
                <ContentControl Content="{Binding Info}" />
            </TabItem>
            <TabItem Header="NODES">
                <ContentControl Content="{Binding Nodes}" />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Classes="panel" Padding="24,8" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource CpDim}" IsVisible="{Binding !StatusIsError}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource CpRed}" IsVisible="{Binding StatusIsError}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="UNSAVED CHANGES" Foreground="{StaticResource CpYellow}" FontWeight="Bold" IsVisible="{Binding IsDirty}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
