<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelicWriter.Views.InventoryView">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="0,0,0,16">

        <!-- Eddies, sub-inventory and search, like the top of the in-game inventory -->
        <Border Classes="panel">
            <Grid ColumnDefinitions="260,*,240" ColumnSpacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="EDDIES" />
                    <NumericUpDown Value="{Binding Money}" Minimum="0" Maximum="2147483647" Increment="1000" FormatString="N0" IsEnabled="{Binding CanEditMoney}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="h2" Text="CONTAINER" />
                    <ComboBox ItemsSource="{Binding Subs}" SelectedItem="{Binding SelectedSub}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="h2" Text="SEARCH" />
                    <TextBox Text="{Binding Search}" MaxLength="32" PlaceholderText="Item name" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="16">
            <Border Classes="panel">
                <ListBox Classes="tiles" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="120" Height="96" RowDefinitions="Auto,*,Auto">
                                <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="10" FontWeight="Bold" LetterSpacing="1.5" />
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="{Binding QuantityBadge}" Foreground="{StaticResource CpYellow}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Item details -->
            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="10" DataContext="{Binding Selected}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="h2" Text="ITEM" />
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
                    <StackPanel Spacing="4" IsVisible="{Binding HasQuantity}">
                        <TextBlock Classes="dim" Text="QUANTITY" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
                        <NumericUpDown Value="{Binding Quantity}" Minimum="0" Maximum="{Binding MaxQuantity}" Increment="1" FormatString="N0" />
                    </StackPanel>
                    <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Only stack quantities can be edited. Names are read from your game files (or a bundled list if the game was not found); items neither knows, for example from mods, show as Unknown item." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
