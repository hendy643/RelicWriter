<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RelicWriter.Controls"
             xmlns:data="using:RelicWriter.Common.GameData"
             x:Class="RelicWriter.Views.InventoryView">
    <UserControl.DataTemplates>
        <!-- The tooltip of an item: its exact version (quality and type, source, record), then the game's description -->
        <DataTemplate DataType="data:ItemInfo">
            <StackPanel Spacing="4" MaxWidth="320">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Kind}" Foreground="{StaticResource CpYellow}" FontWeight="Bold" />
                <TextBlock Classes="dim" Text="{Binding Category}" FontSize="11" />
                <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="dim" Text="{Binding Source}" FontSize="11" />
                <TextBlock Classes="dim" Text="{Binding RecordId}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="0,0,0,16">

        <!-- Eddies, sub-inventory and search, like the top of the in-game inventory -->
        <controls:NotchedBorder Classes="panel">
            <Grid ColumnDefinitions="260,*,240" ColumnSpacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="EDDIES" />
                    <NumericUpDown Value="{Binding Money}" Minimum="0" Maximum="2147483647" Increment="1000" FormatString="N0" IsEnabled="{Binding CanEditMoney}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="h2" Text="CONTAINER" />
                    <ComboBox ItemsSource="{Binding Subs}" SelectedItem="{Binding SelectedSub}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="h2" Text="SEARCH" />
                    <TextBox Text="{Binding Search}" MaxLength="32" PlaceholderText="Item name" />
                </StackPanel>
            </Grid>
        </controls:NotchedBorder>

        <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="16">
            <controls:NotchedBorder Classes="panel">
                <ListBox Classes="tiles" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="120" Height="96" RowDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding Info}">
                                <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="10" FontWeight="Bold" LetterSpacing="1.5" />
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="{Binding QuantityBadge}" Foreground="{StaticResource CpYellow}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </controls:NotchedBorder>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
                <!-- Item details -->
                <controls:NotchedBorder Classes="panel" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="10" DataContext="{Binding Selected}">
                        <TextBlock Classes="h2" Text="ITEM" />
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Classes="dim" Text="{Binding Subtitle}" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
                        <StackPanel Spacing="4" IsVisible="{Binding HasQuantity}">
                            <TextBlock Classes="dim" Text="QUANTITY" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
                            <NumericUpDown Value="{Binding Quantity}" Minimum="0" Maximum="{Binding MaxQuantity}" Increment="1" FormatString="N0" />
                        </StackPanel>
                        <Button Content="DELETE ITEM" Command="{Binding $parent[UserControl].DataContext.DeleteItemCommand}" />
                    </StackPanel>
                </controls:NotchedBorder>

                <!-- Add an item from the game's catalogue to V's bag -->
                <controls:NotchedBorder Grid.Row="1" Classes="panel">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
                        <TextBlock Classes="h2" Text="ADD ITEM" />
                        <TextBox Grid.Row="1" Text="{Binding PickerQuery}" MaxLength="32" PlaceholderText="Search by name, type or quality" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding PickerCategory}" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding PickerType}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding PickerQuality}" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding ResultsText}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                        <ListBox Grid.Row="4" ItemsSource="{Binding Results}" SelectedItem="{Binding PickerSelected}" MinHeight="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent" ToolTip.Tip="{Binding}">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="dim" Text="{Binding Category}" FontSize="11" />
                                            <TextBlock Classes="dim" Text="{Binding Type}" FontSize="11" />
                                            <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="{StaticResource CpYellow}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <NumericUpDown Value="{Binding AddQuantity}" Minimum="1" Maximum="9999" Increment="1" FormatString="N0" IsEnabled="{Binding AddHasQuantity}" />
                            <Button Grid.Column="1" Content="ADD TO BAG" Command="{Binding AddItemCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="6" Classes="dim" FontSize="12" TextWrapping="Wrap"
                                   Text="{Binding AddStatus}" />
                    </Grid>
                </controls:NotchedBorder>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
