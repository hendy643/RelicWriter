<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RelicWriter.Views.PreviewWindow"
        Title="CHARACTER PREVIEW"
        Width="420" Height="620" MinWidth="300" MinHeight="400"
        ShowInTaskbar="False" ShowActivated="False"
        Background="{StaticResource CpBackground}">
    <Border Classes="panel" Margin="12">
        <StackPanel Spacing="12" VerticalAlignment="Top">
            <TextBlock Classes="h2" Text="CHARACTER PREVIEW" />
            <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding Message}" />
            <Rectangle Height="1" Fill="{StaticResource CpLine}" Margin="0,8" />
            <TextBlock Classes="h2" Text="GAME FILES" />
            <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding GameFolderText}" />
        </StackPanel>
    </Border>
</Window>
