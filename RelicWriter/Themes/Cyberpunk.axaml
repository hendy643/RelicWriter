<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RelicWriter.Controls">

    <Styles.Resources>
        <Color x:Key="CpBackgroundColor">#07080C</Color>
        <Color x:Key="CpPanelColor">#D90D1019</Color>
        <Color x:Key="CpPanelRaisedColor">#151A28</Color>
        <Color x:Key="CpLineColor">#5C2430</Color>
        <Color x:Key="CpYellowColor">#FCEE09</Color>
        <Color x:Key="CpCyanColor">#4FF1F6</Color>
        <Color x:Key="CpRedColor">#E8454F</Color>
        <Color x:Key="CpTextColor">#EEF0F7</Color>
        <Color x:Key="CpDimColor">#8C93A8</Color>

        <SolidColorBrush x:Key="CpBackground" Color="{StaticResource CpBackgroundColor}" />
        <!-- The window ground: maroon glow at the top like the game's menus, fading to near black -->
        <LinearGradientBrush x:Key="CpWindow" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#2E0C14" />
            <GradientStop Offset="0.35" Color="#14090F" />
            <GradientStop Offset="1" Color="#07080C" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CpPanel" Color="{StaticResource CpPanelColor}" />
        <SolidColorBrush x:Key="CpPanelRaised" Color="{StaticResource CpPanelRaisedColor}" />
        <SolidColorBrush x:Key="CpLine" Color="{StaticResource CpLineColor}" />
        <SolidColorBrush x:Key="CpYellow" Color="{StaticResource CpYellowColor}" />
        <SolidColorBrush x:Key="CpCyan" Color="{StaticResource CpCyanColor}" />
        <SolidColorBrush x:Key="CpRed" Color="{StaticResource CpRedColor}" />
        <SolidColorBrush x:Key="CpText" Color="{StaticResource CpTextColor}" />
        <SolidColorBrush x:Key="CpDim" Color="{StaticResource CpDimColor}" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource CpWindow}" />
        <Setter Property="Foreground" Value="{StaticResource CpText}" />
        <!-- Rajdhani (bundled, SIL OFL, see Assets/Fonts/OFL.txt) is the game's condensed type; it runs small, so the sizes are a step up -->
        <Setter Property="FontFamily" Value="avares://RelicWriter/Assets/Fonts#Rajdhani" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Panels: flat, hard-edged, with an accent edge like the game's cards -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource CpPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="controls|NotchedBorder.panel">
        <Setter Property="Background" Value="{StaticResource CpPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CpPanelRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpRed}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="controls|NotchedBorder.card">
        <Setter Property="Background" Value="{StaticResource CpPanelRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpRed}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="LetterSpacing" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource CpYellow}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="2.5" />
        <Setter Property="Foreground" Value="{StaticResource CpCyan}" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{StaticResource CpDim}" />
    </Style>
    <Style Selector="TextBlock.big">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="{StaticResource CpText}" />
    </Style>
    <Style Selector="TextBlock.huge">
        <Setter Property="FontSize" Value="72" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="{StaticResource CpCyan}" />
    </Style>

    <!-- Tabs: the game's top navigation, red capitals with a line under each, cyan for the open one -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{StaticResource CpRed}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="TabItem /template/ Rectangle#PillRect">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource CpCyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpCyan}" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{StaticResource CpCyan}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CpRed}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpRed}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1A0C14" />
        <Setter Property="BorderBrush" Value="{StaticResource CpCyan}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource CpCyan}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource CpYellow}" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="BorderBrush" Value="{StaticResource CpYellow}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CpCyan}" />
        <Setter Property="Foreground" Value="#000000" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#4A4710" />
        <Setter Property="Foreground" Value="#8C8730" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource CpBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource CpBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource CpBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{StaticResource CpCyan}" />
    </Style>

    <!-- Perk tree: octagons that fill amber when bought (blue in the Relic tree), joined by lines that light up from a bought perk -->
    <Style Selector="Polygon.perk">
        <Setter Property="Fill" Value="#0B1220" />
        <Setter Property="Stroke" Value="#3A4766" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Panel.node:pointerover Polygon.perk">
        <Setter Property="Stroke" Value="{StaticResource CpCyan}" />
    </Style>
    <Style Selector="Polygon.perk.bought">
        <Setter Property="Fill" Value="#3A2C0B" />
        <Setter Property="Stroke" Value="#FFC83A" />
    </Style>
    <Style Selector="Polygon.perk.maxed">
        <Setter Property="Fill" Value="#6B500F" />
    </Style>
    <Style Selector="Polygon.perk.relic.bought">
        <Setter Property="Fill" Value="#101F55" />
        <Setter Property="Stroke" Value="#4F7BFF" />
    </Style>
    <Style Selector="Polygon.perk.relic.maxed">
        <Setter Property="Fill" Value="#1B338F" />
    </Style>
    <Style Selector="TextBlock.perklabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CpDim}" />
    </Style>
    <Style Selector="TextBlock.perklabel.bought">
        <Setter Property="Foreground" Value="{StaticResource CpText}" />
    </Style>
    <Style Selector="Polyline.link">
        <Setter Property="Stroke" Value="#2A3350" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Polyline.link.on">
        <Setter Property="Stroke" Value="#B8892A" />
    </Style>
    <Style Selector="Polyline.link.relic.on">
        <Setter Property="Stroke" Value="#3A5FCC" />
    </Style>

    <!-- Inventory tiles -->
    <Style Selector="ListBox.tiles">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Background" Value="{StaticResource CpPanelRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#202637" />
        <Setter Property="BorderBrush" Value="{StaticResource CpCyan}" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A2A08" />
        <Setter Property="BorderBrush" Value="{StaticResource CpYellow}" />
    </Style>

    <!-- Vehicle tiles: a toggle that is ticked when the vehicle is unlocked -->
    <Style Selector="ToggleButton.vehicle">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource CpPanelRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource CpLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.vehicle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#202637" />
        <Setter Property="BorderBrush" Value="{StaticResource CpCyan}" />
    </Style>
    <Style Selector="ToggleButton.vehicle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A2A08" />
        <Setter Property="BorderBrush" Value="{StaticResource CpYellow}" />
    </Style>
</Styles>
