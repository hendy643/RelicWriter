<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RelicWriter"
             x:Class="RelicWriter.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Fluent derives focus rings, selections and sliders from these -->
            <Color x:Key="SystemAccentColor">#4FF1F6</Color>
            <Color x:Key="SystemAccentColorLight1">#7FF6FA</Color>
            <Color x:Key="SystemAccentColorLight2">#A5F9FC</Color>
            <Color x:Key="SystemAccentColorLight3">#C9FCFD</Color>
            <Color x:Key="SystemAccentColorDark1">#2FC8CD</Color>
            <Color x:Key="SystemAccentColorDark2">#1F9A9E</Color>
            <Color x:Key="SystemAccentColorDark3">#146E71</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Themes/Cyberpunk.axaml" />
    </Application.Styles>
</Application>
